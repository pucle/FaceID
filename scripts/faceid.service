# Linux: sudo cp scripts/faceid.service /etc/systemd/system/ && sudo systemctl enable --now faceid
[Unit]
Description=Club Face ID attendance service
After=network-online.target
[Service]
WorkingDirectory=/opt/club_face_id
EnvironmentFile=/etc/faceid.env
ExecStart=/opt/club_face_id/.venv/bin/python attendance_service.py --pilot-dir pilot
Restart=always
RestartSec=10
Nice=10
[Install]
WantedBy=multi-user.target
